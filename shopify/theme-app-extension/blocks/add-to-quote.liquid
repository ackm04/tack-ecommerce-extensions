{%- liquid
  assign tenant_id = block.settings.tenant_id | strip
  assign api_base = block.settings.api_base_url | strip | remove_last: '/'
  assign variant = product.selected_or_first_available_variant
-%}

{%- if tenant_id == blank or api_base == blank -%}
  {%- if request.design_mode -%}
    <div class="tackquote-setup" {{ block.shopify_attributes }}>
      <strong>{{ 'tackquote.setup.title' | t }}</strong>
      <p>{{ 'tackquote.setup.body' | t }}</p>
    </div>
  {%- endif -%}
{%- else -%}
  <div
    class="tackquote-block tackquote-add"
    data-tackquote-mode="add"
    data-tackquote-tenant="{{ tenant_id | escape }}"
    data-tackquote-api="{{ api_base | escape }}"
    data-tackquote-product="{{ product.title | escape }}"
    data-tackquote-variant="{{ variant.id }}"
    data-tackquote-currency="{{ cart.currency.iso_code | default: shop.currency }}"
    {{ block.shopify_attributes }}
  >
    {% render 'tackquote-selection', product: product %}
    <button
      type="button"
      class="tackquote-button tackquote-button--{{ block.settings.button_style }}"
      data-tackquote-action="add"
    >
      {{ block.settings.button_label | default: 'Add to Quote' }}
    </button>
    <p class="tackquote-status" data-tackquote-status role="status" aria-live="polite"></p>
  </div>

  {% render 'tackquote-drawer' %}
  <script src="{{ 'tackquote-shared.js' | asset_url }}" async></script>
{%- endif -%}

{% schema %}
{
  "name": "Add to Quote",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "stylesheet": "tackquote.css",
  "javascript": "tackquote-quote.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "Find your Tenant ID in TackQuote under Settings. The block stays hidden from shoppers until it is set."
    },
    {
      "type": "text",
      "id": "tenant_id",
      "label": "TackQuote Tenant ID"
    },
    {
      "type": "text",
      "id": "api_base_url",
      "label": "TackQuote API URL",
      "default": "https://api.tackquote.com/v1",
      "info": "Change this only on a dedicated or self-hosted TackQuote instance."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Add to Quote"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ],
      "default": "outline"
    }
  ]
}
{% endschema %}
