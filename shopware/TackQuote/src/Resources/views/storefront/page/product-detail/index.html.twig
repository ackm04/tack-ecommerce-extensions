{% sw_extends '@Storefront/storefront/page/product-detail/index.html.twig' %}

{% block page_product_detail_buy %}
    {{ parent() }}

    {% if config('TackQuote.config.enableButton') %}
        <div class="tack-quote-request mt-2"
             data-product-id="{{ page.product.id }}"
             data-product-number="{{ page.product.productNumber }}"
             data-product-name="{{ page.product.translated.name|default(page.product.name) }}"
             data-unit-price="{{ page.product.calculatedPrice.unitPrice|default(0) }}"
             data-product-url="{{ seoUrl('frontend.detail.page', { productId: page.product.id }) }}"
             data-endpoint="{{ path('frontend.tackquote.quote-request') }}"
             data-csrf-token="{{ sw_csrf('frontend.tackquote.quote-request', { mode: 'token' }) }}">

            <button type="button"
                    class="btn btn-outline-primary btn-block js-tack-quote-open">
                {{ config('TackQuote.config.buttonLabel')|default('Request a Quote') }}
            </button>

            <div class="tack-quote-modal-backdrop" style="display:none;" aria-hidden="true"></div>

            <div class="tack-quote-modal card" style="display:none;" role="dialog" aria-modal="true" aria-label="{{ 'Request a Quote'|trans|default('Request a Quote') }}">
                <div class="card-body">
                    <button type="button" class="btn-close js-tack-quote-close float-end" aria-label="Close"></button>
                    <h5 class="card-title">{{ config('TackQuote.config.buttonLabel')|default('Request a Quote') }}</h5>
                    <p class="text-muted small mb-3">{{ page.product.translated.name|default(page.product.name) }}</p>

                    <div class="js-tack-quote-error alert alert-danger" style="display:none;"></div>
                    <div class="js-tack-quote-success alert alert-success" style="display:none;"></div>

                    <form class="js-tack-quote-form">
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label">First name *</label>
                                <input type="text" name="firstName" class="form-control" required>
                            </div>
                            <div class="col-6">
                                <label class="form-label">Last name</label>
                                <input type="text" name="lastName" class="form-control">
                            </div>
                        </div>
                        <div class="mt-2">
                            <label class="form-label">Email *</label>
                            <input type="email" name="email" class="form-control" required>
                        </div>
                        <div class="row g-2 mt-2">
                            <div class="col-6">
                                <label class="form-label">Company</label>
                                <input type="text" name="company" class="form-control">
                            </div>
                            <div class="col-6">
                                <label class="form-label">Quantity</label>
                                <input type="number" name="quantity" class="form-control" value="1" min="1">
                            </div>
                        </div>
                        <div class="mt-2">
                            <label class="form-label">Message</label>
                            <textarea name="message" class="form-control" rows="2"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3 w-100 js-tack-quote-submit">
                            Submit request
                        </button>
                    </form>
                </div>
            </div>
        </div>

        {% block page_product_detail_tack_quote_script %}
            <script>
                (function () {
                    document.addEventListener('DOMContentLoaded', function () {
                        var roots = document.querySelectorAll('.tack-quote-request');
                        roots.forEach(function (root) {
                            var openBtn = root.querySelector('.js-tack-quote-open');
                            var closeBtn = root.querySelector('.js-tack-quote-close');
                            var backdrop = root.querySelector('.tack-quote-modal-backdrop');
                            var modal = root.querySelector('.tack-quote-modal');
                            var form = root.querySelector('.js-tack-quote-form');
                            var errorBox = root.querySelector('.js-tack-quote-error');
                            var successBox = root.querySelector('.js-tack-quote-success');
                            var submitBtn = root.querySelector('.js-tack-quote-submit');

                            function toggle(show) {
                                backdrop.style.display = show ? 'block' : 'none';
                                modal.style.display = show ? 'block' : 'none';
                            }

                            openBtn.addEventListener('click', function () { toggle(true); });
                            closeBtn.addEventListener('click', function () { toggle(false); });
                            backdrop.addEventListener('click', function () { toggle(false); });

                            form.addEventListener('submit', function (evt) {
                                evt.preventDefault();
                                errorBox.style.display = 'none';
                                successBox.style.display = 'none';
                                submitBtn.disabled = true;

                                var data = new URLSearchParams(new FormData(form));
                                data.set('productId', root.getAttribute('data-product-id'));
                                data.set('productNumber', root.getAttribute('data-product-number'));
                                data.set('productName', root.getAttribute('data-product-name'));
                                data.set('unitPrice', root.getAttribute('data-unit-price'));
                                data.set('productUrl', root.getAttribute('data-product-url'));

                                fetch(root.getAttribute('data-endpoint'), {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/x-www-form-urlencoded',
                                        'x-csrf-token': root.getAttribute('data-csrf-token'),
                                        'X-Requested-With': 'XMLHttpRequest'
                                    },
                                    body: data.toString()
                                })
                                    .then(function (r) { return r.json(); })
                                    .then(function (json) {
                                        submitBtn.disabled = false;
                                        if (json.success) {
                                            successBox.textContent = 'Quote request submitted' + (json.quoteNumber ? ' (' + json.quoteNumber + ')' : '') + '. You will hear from us shortly.';
                                            successBox.style.display = 'block';
                                            form.style.display = 'none';
                                        } else {
                                            errorBox.textContent = json.message || 'Something went wrong. Please try again.';
                                            errorBox.style.display = 'block';
                                        }
                                    })
                                    .catch(function () {
                                        submitBtn.disabled = false;
                                        errorBox.textContent = 'Network error. Please try again.';
                                        errorBox.style.display = 'block';
                                    });
                            });
                        });
                    });
                })();
            </script>
        {% endblock %}
    {% endif %}
{% endblock %}
