{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-tackquote" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    {# Save success / failure is rendered by OpenCart's own common.js into the
       `#alert` container that common/header.twig provides, from the JSON that
       `…tackquotes.save` returns. There is deliberately no `{% if success %}` /
       `{% if error_warning %}` block here any more: those read controller keys
       that did not match what validate() wrote, so the error banner was
       structurally unreachable and a permission denial showed the merchant
       nothing at all. One key path, and it is the vendor's. #}
    <div id="tackquote-test-result"></div>

    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-tackquote" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="mb-3 row">
            <label class="col-sm-2 col-form-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_tackquotes_status" id="input-status" class="form-select">
                <option value="1" {% if module_tackquotes_status %}selected{% endif %}>{{ text_enabled }}</option>
                <option value="0" {% if not module_tackquotes_status %}selected{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
          <div class="mb-3 row">
            <label class="col-sm-2 col-form-label" for="input-api-url">{{ entry_api_url }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_tackquotes_api_url" value="{{ module_tackquotes_api_url }}" id="input-api-url" class="form-control">
              {# common.js fills `#error-<key>` from `$json['error']['<key>']`, mapping
                 underscores to dashes — so save()'s `api_url` key lands here. Without
                 this element an invalid URL was rejected completely silently. #}
              <div id="error-api-url" class="invalid-feedback"></div>
              <div class="form-text">{{ entry_api_url_help }}</div>
            </div>
          </div>
          <div class="mb-3 row">
            <label class="col-sm-2 col-form-label" for="input-api-key">{{ entry_api_key }}</label>
            <div class="col-sm-10">
              <input type="password" name="module_tackquotes_api_key" value="" id="input-api-key" class="form-control" autocomplete="new-password">
              <div class="form-text">
                {% if module_tackquotes_api_key_masked %}
                  {{ entry_api_key_saved|replace({'%s': module_tackquotes_api_key_masked}) }}
                {% else %}
                  {{ entry_api_key_help }}
                {% endif %}
              </div>
            </div>
          </div>
          <div class="mb-3 row">
            <label class="col-sm-2 col-form-label" for="input-connector-token">{{ entry_connector_token }}</label>
            <div class="col-sm-10">
              <input type="password" name="module_tackquotes_connector_token" value="" id="input-connector-token" class="form-control" autocomplete="new-password">
              <div class="form-text">
                {% if module_tackquotes_connector_token_masked %}
                  {{ entry_connector_token_saved|replace({'%s': module_tackquotes_connector_token_masked}) }}
                {% else %}
                  {{ entry_connector_token_help }}
                {% endif %}
              </div>
              <div class="form-text"><code>{{ module_tackquotes_connector_url }}</code></div>
            </div>
          </div>
          <div class="mb-3 row">
            <label class="col-sm-2 col-form-label" for="input-button-label">{{ entry_button_label }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_tackquotes_button_label" value="{{ module_tackquotes_button_label }}" id="input-button-label" class="form-control">
              <div class="form-text">{{ entry_button_label_help }}</div>
            </div>
          </div>
          <div class="mb-3 row">
            <label class="col-sm-2 col-form-label" for="input-add-label">{{ entry_add_label }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_tackquotes_add_label" value="{{ module_tackquotes_add_label }}" id="input-add-label" class="form-control">
              <div class="form-text">{{ entry_add_label_help }}</div>
            </div>
          </div>
          <div class="mb-3 row">
            <label class="col-sm-2 col-form-label" for="input-inline-button">{{ entry_inline_button }}</label>
            <div class="col-sm-10">
              <select name="module_tackquotes_inline_button" id="input-inline-button" class="form-select">
                <option value="1" {% if module_tackquotes_inline_button %}selected{% endif %}>{{ text_enabled }}</option>
                <option value="0" {% if not module_tackquotes_inline_button %}selected{% endif %}>{{ text_disabled }}</option>
              </select>
              <div class="form-text">{{ entry_inline_button_help }}</div>
            </div>
          </div>
          <div class="mb-3 row">
            <label class="col-sm-2 col-form-label" for="input-quote-list">{{ entry_quote_list }}</label>
            <div class="col-sm-10">
              <select name="module_tackquotes_quote_list" id="input-quote-list" class="form-select">
                <option value="1" {% if module_tackquotes_quote_list %}selected{% endif %}>{{ text_enabled }}</option>
                <option value="0" {% if not module_tackquotes_quote_list %}selected{% endif %}>{{ text_disabled }}</option>
              </select>
              <div class="form-text">{{ entry_quote_list_help }}</div>
            </div>
          </div>
          <div class="mb-3 row">
            <label class="col-sm-2 col-form-label" for="input-listing-button">{{ entry_listing_button }}</label>
            <div class="col-sm-10">
              <select name="module_tackquotes_listing_button" id="input-listing-button" class="form-select">
                <option value="1" {% if module_tackquotes_listing_button %}selected{% endif %}>{{ text_enabled }}</option>
                <option value="0" {% if not module_tackquotes_listing_button %}selected{% endif %}>{{ text_disabled }}</option>
              </select>
              <div class="form-text">{{ entry_listing_button_help }}</div>
            </div>
          </div>
          {# ── Quote-only / B2B catalog mode ─────────────────────────────────────────────
             The scope select and the group list are plain form controls: no JS is needed to
             show or hide the group picker, because a group selection is simply ignored
             unless the scope is "groups" (QuoteOnly::applies), and save() refuses the
             combination that would silently match nobody. A show/hide script here would be
             one more thing that can fail open on a page that decides whether a shop can
             take money. #}
          <div class="mb-3 row">
            <label class="col-sm-2 col-form-label" for="input-quote-only">{{ entry_quote_only }}</label>
            <div class="col-sm-10">
              <select name="module_tackquotes_quote_only" id="input-quote-only" class="form-select">
                <option value="1" {% if module_tackquotes_quote_only %}selected{% endif %}>{{ text_enabled }}</option>
                <option value="0" {% if not module_tackquotes_quote_only %}selected{% endif %}>{{ text_disabled }}</option>
              </select>
              {# common.js fills `#error-<key>` from `$json['error']['<key>']` with underscores
                 mapped to dashes, so save()'s `quote_only` key lands here. Without this
                 element the "save an API key first" refusal would be invisible. #}
              <div id="error-quote-only" class="invalid-feedback"></div>
              <div class="form-text">{{ entry_quote_only_help }}</div>
            </div>
          </div>
          <div class="mb-3 row">
            <label class="col-sm-2 col-form-label" for="input-quote-only-scope">{{ entry_quote_only_scope }}</label>
            <div class="col-sm-10">
              <select name="module_tackquotes_quote_only_scope" id="input-quote-only-scope" class="form-select">
                {% for scope in quote_only_scopes %}
                  <option value="{{ scope.value }}" {% if module_tackquotes_quote_only_scope == scope.value %}selected{% endif %}>{{ scope.text }}</option>
                {% endfor %}
              </select>
              <div class="form-text">{{ entry_quote_only_scope_help }}</div>
            </div>
          </div>
          <div class="mb-3 row">
            <label class="col-sm-2 col-form-label" for="input-quote-only-groups">{{ entry_quote_only_groups }}</label>
            <div class="col-sm-10">
              <div id="input-quote-only-groups" class="form-control" style="height: 150px; overflow: auto;">
                {% for customer_group in customer_groups %}
                  <div class="form-check">
                    <input type="checkbox" name="module_tackquotes_quote_only_groups[]"
                           value="{{ customer_group.customer_group_id }}"
                           id="input-quote-only-group-{{ customer_group.customer_group_id }}"
                           class="form-check-input"
                           {% if customer_group.customer_group_id in module_tackquotes_quote_only_groups %}checked{% endif %}>
                    <label for="input-quote-only-group-{{ customer_group.customer_group_id }}" class="form-check-label">{{ customer_group.name }}</label>
                  </div>
                {% endfor %}
              </div>
              <div id="error-quote-only-groups" class="invalid-feedback d-block"></div>
              <div class="form-text">{{ entry_quote_only_groups_help }}</div>
            </div>
          </div>
          <div class="mb-3 row">
            <div class="col-sm-10 offset-sm-2">
              {# No `data-oc-toggle="ajax"` / `data-oc-target` here: common.js only honours those
                 from its `submit` handler, and this is a type="button", so they never did
                 anything. Removed rather than left as a misleading hint that the framework
                 drives this button — the fetch() below does. The error text rides in a data
                 attribute so it goes through Twig's HTML escaping instead of being
                 interpolated into a JS string literal, where an apostrophe would break out. #}
              <button type="button" id="button-test" class="btn btn-secondary" data-tack-ajax-error="{{ error_ajax }}">{{ button_test }}</button>
              <div class="form-text">{{ entry_button_help }}</div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
(function () {
  var button = document.getElementById('button-test');
  var resultEl = document.getElementById('tackquote-test-result');

  /**
   * Render the test-connection outcome.
   *
   * textContent, never innerHTML. On the failure path `message` is built from
   * whatever the host in "TackQuote API URL" returned, and that field is
   * merchant-editable — so a response body containing `<img src=x onerror=...>`
   * used to be parsed as markup and executed inside the authenticated admin
   * session. The alert is assembled with createElement and the untrusted string
   * is assigned to textContent, so no markup is ever parsed from a value.
   */
  function showResult(variant, message) {
    var alertEl = document.createElement('div');
    alertEl.className = 'alert alert-' + variant;
    alertEl.textContent = message;

    // Clears every existing child without parsing markup.
    resultEl.textContent = '';
    resultEl.appendChild(alertEl);
  }

  button.addEventListener('click', function () {
    resultEl.textContent = '';

    var body = new URLSearchParams();
    body.set('module_tackquotes_api_url', document.getElementById('input-api-url').value);
    body.set('module_tackquotes_api_key', document.getElementById('input-api-key').value);

    fetch('{{ test_action }}', {
      method: 'post',
      headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
      body: body.toString(),
    })
      .then(function (res) { return res.json(); })
      .then(function (json) {
        if (json.error) {
          showResult('danger', json.error);
        } else if (json.success) {
          showResult('success', json.success);
        }
      })
      .catch(function () {
        showResult('danger', button.dataset.tackAjaxError);
      });
  });
})();
//--></script>
{{ footer }}
