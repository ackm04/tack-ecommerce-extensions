<?xml version="1.0"?>
<!--
  TackQuote admin dashboard layout.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="admin-1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="TackQuote_Quotes::css/dashboard.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="TackQuote\Quotes\Block\Adminhtml\Dashboard"
                   name="tackquote.dashboard"
                   template="TackQuote_Quotes::dashboard.phtml"/>
        </referenceContainer>
    </body>
</page>
