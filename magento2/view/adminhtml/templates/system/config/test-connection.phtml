<?php
/**
 * "Test connection" control inside Stores > Configuration > TackQuote.
 *
 * @var \TackQuote\Quotes\Block\Adminhtml\System\Config\TestConnection $block
 * @var \Magento\Framework\Escaper $escaper
 * @package TackQuote_Quotes
 */
?>
<?= /* @noEscape */ $block->getButtonHtml() ?>
<span class="tq-config-result" id="tackquote_test_connection_result" role="status" aria-live="polite" hidden></span>

<script>
    require(['jquery', 'mage/translate'], function ($, $t) {
        'use strict';

        var $btn = $('#tackquote_test_connection_button'),
            $out = $('#tackquote_test_connection_result');

        $btn.on('click', function () {
            $btn.prop('disabled', true);
            $out.prop('hidden', false)
                .attr('class', 'tq-config-result tq-config-result--pending')
                .text($t('Testing…'));

            $.ajax({
                url: '<?= $escaper->escapeJs($block->getAjaxUrl()) ?>',
                type: 'POST',
                dataType: 'json',
                data: { form_key: window.FORM_KEY }
            }).done(function (data) {
                $out.attr(
                    'class',
                    'tq-config-result tq-config-result--' + (data && data.success ? 'ok' : 'error')
                ).text((data && data.message) || $t('Unexpected response.'));
            }).fail(function () {
                $out.attr('class', 'tq-config-result tq-config-result--error')
                    .text($t('Could not reach the server.'));
            }).always(function () {
                $btn.prop('disabled', false);
            });
        });
    });
</script>

<style>
    /*
     * Scoped to this control. The configuration screen has no styling hook of its own for
     * an inline async result, and loading the whole dashboard stylesheet here would pull
     * in layout rules that do not belong on a config form.
     */
    .tq-config-result {
        display: inline-block;
        margin-left: 12px;
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 1.2rem;
        line-height: 1.6;
        vertical-align: middle;
    }
    .tq-config-result[hidden] {
        display: none !important;
    }
    .tq-config-result--pending {
        background: #f5f5f5;
        color: #555;
    }
    .tq-config-result--ok {
        background: #ecfdf5;
        color: #047857;
    }
    .tq-config-result--error {
        background: #fef2f2;
        color: #b91c1c;
    }
</style>
