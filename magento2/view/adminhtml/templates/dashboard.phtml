<?php
/**
 * TackQuote admin dashboard.
 *
 * CSP — the behaviour script goes out through SecureHtmlRenderer rather than as a literal
 * <script> tag, so Magento\Csp\Helper\InlineUtil can stamp it with the request nonce once a
 * merchant drops 'unsafe-inline' from script-src. Without that the "Test connection" button
 * is simply dead in the browser and nothing reaches var/log. $secureRenderer arrives as a
 * block variable from app/etc/di.xml; there is nothing to inject.
 *
 * The endpoint and the three status strings travel out of PHP as data attributes and
 * mage/translate lookups respectively, so the script itself is a constant with no
 * server-side interpolation to escape.
 *
 * @var \TackQuote\Quotes\Block\Adminhtml\Dashboard $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 * @package TackQuote_Quotes
 */

$checklist = $block->getChecklist();
$allOk = true;
foreach ($checklist as $item) {
    $allOk = $allOk && $item['ok'];
}
?>
<div class="tq-admin">
    <div class="tq-admin__header">
        <div>
            <h1 class="tq-admin__title"><?= $escaper->escapeHtml(__('TackQuote')) ?></h1>
            <p class="tq-admin__subtitle">
                <?= $escaper->escapeHtml(__('B2B quoting and CPQ for your Magento storefront.')) ?>
            </p>
        </div>
        <div class="tq-admin__actions">
            <button type="button" class="tq-btn tq-btn--secondary" id="tq-test-connection">
                <?= $escaper->escapeHtml(__('Test connection')) ?>
            </button>
            <a class="tq-btn tq-btn--primary" href="<?= $escaper->escapeUrl($block->getSettingsUrl()) ?>">
                <?= $escaper->escapeHtml(__('Settings')) ?>
            </a>
        </div>
    </div>

    <div class="tq-status tq-status--<?= $allOk ? 'ok' : 'warn' ?>" id="tq-status">
        <span class="tq-status__dot" aria-hidden="true"></span>
        <span class="tq-status__text">
            <?= $escaper->escapeHtml(
                $allOk
                    ? __('Ready — the quote button is live on your product pages.')
                    : __('Not live yet — finish the steps below to show the quote button.')
            ) ?>
        </span>
    </div>

    <div class="tq-grid">
        <section class="tq-card">
            <h2 class="tq-card__title"><?= $escaper->escapeHtml(__('Setup')) ?></h2>
            <ul class="tq-checklist">
                <?php foreach ($checklist as $item): ?>
                    <li class="tq-checklist__item tq-checklist__item--<?= $item['ok'] ? 'ok' : 'todo' ?>">
                        <span class="tq-checklist__mark"
                              aria-hidden="true"><?= $item['ok'] ? '&#10003;' : '&#9679;' ?></span>
                        <span class="tq-checklist__body">
                            <span class="tq-checklist__label"><?= $escaper->escapeHtml($item['label']) ?></span>
                            <?php if (!$item['ok']): ?>
                                <span class="tq-checklist__hint"><?= $escaper->escapeHtml($item['hint']) ?></span>
                            <?php endif; ?>
                        </span>
                    </li>
                <?php endforeach; ?>
            </ul>
        </section>

        <section class="tq-card">
            <h2 class="tq-card__title"><?= $escaper->escapeHtml(__('Connection')) ?></h2>
            <dl class="tq-facts">
                <dt><?= $escaper->escapeHtml(__('API base URL')) ?></dt>
                <dd><code><?= $escaper->escapeHtml($block->getApiBaseUrl()) ?></code></dd>

                <dt><?= $escaper->escapeHtml(__('API key')) ?></dt>
                <dd>
                    <?php if ($block->hasApiKey()): ?>
                        <span class="tq-pill tq-pill--ok"><?= $escaper->escapeHtml(__('Set')) ?></span>
                    <?php else: ?>
                        <span class="tq-pill tq-pill--warn"><?= $escaper->escapeHtml(__('Not set')) ?></span>
                    <?php endif; ?>
                </dd>

                <dt><?= $escaper->escapeHtml(__('Button label')) ?></dt>
                <dd><?= $escaper->escapeHtml($block->getButtonLabel()) ?></dd>
            </dl>
            <p class="tq-result"
               id="tq-test-result"
               data-test-url="<?= $escaper->escapeHtmlAttr($block->getTestConnectionUrl()) ?>"
               hidden
               role="status"
               aria-live="polite"></p>
        </section>
    </div>
</div>

<?php
$script = <<<'JS'
require(['jquery', 'mage/translate'], function ($, $t) {
    'use strict';

    var btn = document.getElementById('tq-test-connection'),
        out = document.getElementById('tq-test-result'),
        url = out ? out.getAttribute('data-test-url') : '';

    if (!btn || !out || !url) {
        return;
    }

    btn.addEventListener('click', function () {
        btn.disabled = true;
        out.hidden = false;
        out.className = 'tq-result tq-result--pending';
        out.textContent = $t('Testing…');

        $.ajax({
            url: url,
            type: 'POST',
            dataType: 'json',
            data: { form_key: window.FORM_KEY }
        }).done(function (data) {
            out.className = 'tq-result tq-result--' + (data && data.success ? 'ok' : 'error');
            out.textContent = (data && data.message) || $t('Unexpected response.');
        }).fail(function () {
            out.className = 'tq-result tq-result--error';
            out.textContent = $t('Could not reach the server.');
        }).always(function () {
            btn.disabled = false;
        });
    });
});
JS;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $script, false) ?>
