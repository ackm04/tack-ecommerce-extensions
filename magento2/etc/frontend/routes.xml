<?xml version="1.0"?>
<!--
  Frontend route: /tackquote/quote/submit handles the storefront quote-request
  button's server-side POST (keeps the API key off the browser).
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/routes.xsd">
    <router id="standard">
        <route id="tackquote" frontName="tackquote">
            <module name="TackQuote_Quotes"/>
        </route>
    </router>
</config>
