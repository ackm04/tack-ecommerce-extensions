<?xml version="1.0"?>
<!--
  Admin config section: Stores > Configuration > TackQuote.
  Mirrors what the TackQuote WooCommerce plugin stores as wp_options
  (tack_quotes_api_url / tack_quotes_api_key / tack_quotes_button_label),
  scoped per-website here via Magento's standard scope switcher.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="tackquote" translate="label" sortOrder="200">
            <label>TackQuote</label>
        </tab>
        <section id="tackquote_quotes" translate="label" type="text" sortOrder="200" showInDefault="1" showInWebsite="1" showInStore="0">
            <label>TackQuote Settings</label>
            <tab>tackquote</tab>
            <resource>TackQuote_Quotes::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Connection</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enable TackQuote</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Turns the storefront "Request a Quote" button and quote-request calls on or off.</comment>
                </field>
                <field id="api_base_url" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>TackQuote API Base URL</label>
                    <comment>Default is https://api.tackquote.com/v1. Include the /v1 path, no trailing slash. Change only for a staging/custom deployment.</comment>
                </field>
                <field id="api_key" translate="label comment" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>TackQuote API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Create an API key in TackQuote under Settings &gt; Developer &gt; API Keys, then paste it here. Stored encrypted using Magento's crypt key.</comment>
                </field>
            </group>
            <group id="storefront" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Request a Quote button</label>
                <field id="show_button" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Show quote button on product pages</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When enabled, shoppers see a "Request a Quote" button on the product view page. Submitting it creates a quote request in TackQuote — it does not add to cart or affect checkout.</comment>
                </field>
                <field id="button_label" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Button label</label>
                </field>
            </group>
        </section>
    </system>
</config>
